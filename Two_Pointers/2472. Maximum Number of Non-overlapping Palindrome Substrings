class Solution(object):
    def maxPalindromes(self, s, k):
        """
        :type s: str
        :type k: int
        :rtype: int
        """
        n = len(s)
        dp = [0] * (n + 1)

        def isPalindrome(l, r):
            while l < r:
                if s[l] != s[r]:
                    return False
                l += 1
                r -= 1
            return True

        for i in range(1, n + 1):
            dp[i] = dp[i - 1]
            for length in (k, k + 1):
                j = i - length
                if j >= 0 and isPalindrome(j, i - 1):
                    dp[i] = max(dp[i], dp[j] + 1)
                    break
        return dp[n]
