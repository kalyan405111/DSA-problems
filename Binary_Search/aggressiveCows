class Solution:
    def aggressiveCows(self, arr, k):
        # code here
        arr.sort()
        n = len(arr)
        
        def canPlace(d):
            count = 1
            lastPos = arr[0]
            for i in range(1, n):
                if arr[i] - lastPos >= d:
                    count += 1
                    lastPos = arr[i]
                    if count >= k:
                        return True
            return count >= k
        
        low, high = 1, arr[n - 1] - arr[0]
        ans = 0
        
        while low <= high:
            mid = low + (high - low) // 2
            if canPlace(mid):
                ans = mid
                low = mid + 1
            else:
                high = mid - 1
        
        return ans
