class Solution(object):
    def characterReplacement(self, s, k):
        left = 0
        freq = {}
        maxfre = 0
        longest = 0

        for right in range(len(s)):
            currentchar = s[right]         
            if currentchar in freq:
                freq[currentchar] += 1
            else:
                freq[currentchar] = 1

            if freq[currentchar] > maxfre:
                maxfre = freq[currentchar]

            window = right - left + 1
            while window - maxfre > k:
                leftchar = s[left]
                freq[leftchar] -= 1         
                left += 1
                window = right - left + 1   

            window = right - left + 1
            if window > longest:
                longest = window

        return longest
