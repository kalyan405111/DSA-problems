class Solution(object):
    def findAnagrams(self, s, p):
        n = len(s)
        m = len(p)
        result = []
        if m > n:
            return result

        target_count = [0] * 26
        window_count = [0] * 26

        for ch in p:
            target_count[ord(ch) - ord('a')] += 1
        for ch in s[:m]:
            window_count[ord(ch) - ord('a')] += 1

        if target_count == window_count:
            result.append(0)

        for i in range(m, n):
            window_count[ord(s[i - m]) - ord('a')] -= 1
            window_count[ord(s[i]) - ord('a')] += 1
            if target_count == window_count:
                result.append(i - m + 1)

        return result
