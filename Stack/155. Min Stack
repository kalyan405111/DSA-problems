class MinStack(object):

    def __init__(self):
        self.stack = []       # holds all values, normal stack behavior
        self.min_stack = []   # min_stack[i] = min of stack[0..i]

    def push(self, value):
        """
        :type value: int
        :rtype: None
        """
        self.stack.append(value)
        if self.min_stack:
            new_min = min(value, self.min_stack[-1])
        else:
            new_min = value
        self.min_stack.append(new_min)

    def pop(self):
        """
        :rtype: None
        """
        self.stack.pop()
        self.min_stack.pop()

    def top(self):
        """
        :rtype: int
        """
        return self.stack[-1]

    def getMin(self):
        """
        :rtype: int
        """
        return self.min_stack[-1]


