class Solution(object):
    def maxArea(self, height):
        best = 0
        l = 0
        r = len(height) - 1
        while l < r:
            dis = r - l
            min_height = min(height[l], height[r])
            area = min_height * dis
            if area > best:
                best = area

            if height[l] < height[r]:
                l += 1
            else:
                r -= 1
        return best
