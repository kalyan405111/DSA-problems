class Solution(object):
    def shipWithinDays(self, weights, days):
        """
        :type weights: List[int]
        :type days: int
        :rtype: int
        """
        def daysNeeded(capacity):
            total_days = 1
            current_load = 0
            for w in weights:
                if current_load + w > capacity:
                    total_days += 1
                    current_load = 0
                current_load += w
            return total_days
        
        low, high = max(weights), sum(weights)
        
        while low < high:
            mid = low + (high - low) // 2
            if daysNeeded(mid) <= days:
                high = mid       # mid works, try smaller capacity
            else:
                low = mid + 1    # mid too small, need more capacity
        
        return low
