class Solution(object):
    def nextGreaterElements(self, nums):
        n = len(nums)
        ans = [-1] * n
        stack = []   # holds indices, values kept decreasing from bottom to top

        for i in range(n * 2 - 1, -1, -1):
            while stack and nums[stack[-1]] <= nums[i % n]:
                stack.pop()
            if i < n and stack:
                ans[i] = nums[stack[-1]]
            stack.append(i % n)

        return ans
