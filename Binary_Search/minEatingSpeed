class Solution(object):
    def minEatingSpeed(self, piles, h):
        """
        :type piles: List[int]
        :type h: int
        :rtype: int
        """
        def hoursNeeded(k):
            hours = 0
            for pile in piles:
                hours += (pile + k - 1) // k   # ceil(pile / k) without float division
            return hours
        
        low, high = 1, max(piles)
        
        while low < high:
            mid = low + (high - low) // 2
            if hoursNeeded(mid) <= h:
                high = mid       # mid works, try to go slower
            else:
                low = mid + 1    # mid too slow, need to speed up
        
        return low
