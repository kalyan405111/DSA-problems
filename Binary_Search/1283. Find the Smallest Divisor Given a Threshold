class Solution(object):
    def smallestDivisor(self, nums, threshold):
        l, r = 1, max(nums)
        while l <= r:
            mid = (l + r) // 2
            total = sum((num + mid - 1) // mid for num in nums)
            if total > threshold:
                l = mid + 1
            else:
                r = mid - 1
        return l
