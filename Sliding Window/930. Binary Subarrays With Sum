from typing import List

class Solution:
    def numSubarraysWithSum(self, nums: List[int], goal: int) -> int:
        def atMost(k: int) -> int:
            if k < 0:
                return 0
            left = 0
            total = 0
            window_sum = 0
            for right, val in enumerate(nums):
                window_sum += val
                while window_sum > k:
                    window_sum -= nums[left]
                    left += 1
                total += right - left + 1
            return total

        return atMost(goal) - atMost(goal - 1)
