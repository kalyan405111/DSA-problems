from typing import List

class Solution:
    def maxSlidingWindow(self, nums: List[int], k: int) -> List[int]:
        result = []
        
        for left in range(len(nums) - k + 1):
            right = left + k - 1
            window = nums[left:right + 1]  
            result.append(max(window))       
        
        return result
